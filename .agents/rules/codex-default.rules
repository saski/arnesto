# Arnesto-owned permission policy in Codex execpolicy syntax.
# Other clients need their own reviewed adapter; ownership stays in Arnesto.
prefix_rule(pattern=["curl", "-I", "-L"], decision="allow")
prefix_rule(pattern=["curl", "-I", "https://mcp.atlassian.com/v1/mcp"], decision="allow")
prefix_rule(pattern=["/Applications/Codex.app/Contents/Resources/codex", "mcp", "remove", "atlassian"], decision="allow")
prefix_rule(pattern=["/Applications/Codex.app/Contents/Resources/codex", "mcp", "add", "atlassian", "--url", "https://mcp.atlassian.com/v1/mcp"], decision="allow")
prefix_rule(pattern=["git", "fetch", "origin"], decision="allow")
prefix_rule(pattern=["npm", "install", "--no-save"], decision="allow")
prefix_rule(pattern=["mkdir", "-p", "/tmp/fc"], decision="allow")
prefix_rule(pattern=["xcrun", "simctl"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["ping"], decision="allow")
prefix_rule(pattern=["networkQuality"], decision="allow")
prefix_rule(pattern=["rtk", "git", "fetch", "origin"], decision="allow")
prefix_rule(pattern=["curl", "-I"], decision="allow")
prefix_rule(pattern=["hermes"], decision="allow")
prefix_rule(pattern=["rtk", "git"], decision="allow")
prefix_rule(pattern=["omniroute", "--output", "json", "providers", "list"], decision="allow")
prefix_rule(pattern=["opencode", "run"], decision="allow")
prefix_rule(pattern=["hermes", "--provider", "omniroute-local"], decision="allow")
prefix_rule(pattern=["omniroute", "simulate"], decision="allow")
prefix_rule(pattern=["npx", "ctx7@latest"], decision="allow")
prefix_rule(pattern=["curl", "-sS", "--max-time", "15", "http://localhost:20128/v1/models"], decision="allow")
prefix_rule(pattern=["omniroute", "providers", "test"], decision="allow")
prefix_rule(pattern=["curl", "-sS", "--max-time", "30", "-X", "POST", "http://localhost:20128/v1/chat/completions"], decision="allow")
prefix_rule(pattern=["curl", "-sS", "--max-time", "30", "-X", "POST", "http://localhost:20128/v1/responses"], decision="allow")
prefix_rule(pattern=["npm", "view", "omniroute"], decision="allow")
prefix_rule(pattern=["curl", "-L", "--max-time", "20", "--fail", "-o", "/private/tmp/edreams-glassdoor-ip2.html", "-w", "%{http_code}\\n", "https://www.glassdoor.es/Entrevista/eDreams-ODIGEO-Software-Engineer-Preguntas-de-entrevista-EI_IE12822.0,14_KO15,32_IP2.htm"], decision="allow")
prefix_rule(pattern=["npx", "--yes", "ctx7@latest", "docs", "/vitest-dev/vitest", "Use @vitest-environment jsdom per test file and vi.spyOn Math.random mockReturnValueOnce with vi.restoreAllMocks"], decision="allow")
